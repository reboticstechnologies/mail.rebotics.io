# Server
PORT=8080
NODE_ENV=production
FRONTEND_ORIGIN=https://mail.rebotics.in

# PostgreSQL
DATABASE_URL=postgresql://rebotics_user:CHANGE_ME@127.0.0.1:5432/rebotics_mail
# Optional SSL for managed PostgreSQL:
# PGSSL=true

# JWT
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Your email domain
MAIL_DOMAIN=rebotics.in
MAIL_FROM_NAME=Rebotics Mail

# Cloudflare Email Service SMTP
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=api_token
SMTP_PASS=YOUR_CLOUDFLARE_API_TOKEN

# Optional inbound Worker -> backend shared secret
INBOUND_WEBHOOK_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
