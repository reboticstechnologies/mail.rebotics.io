# GoDaddy automatically supplies these five values for Hosted MySQL.
# Do NOT manually replace DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD in GoDaddy.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

APP_URL=https://mail.rebotics.in
MAIL_DOMAIN=rebotics.in
JWT_SECRET=replace-with-a-long-random-secret
INBOUND_WEBHOOK_SECRET=replace-with-a-different-long-random-secret

SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=api_token
SMTP_PASS=replace-with-cloudflare-email-sending-api-token
MAIL_FROM_NAME=Rebotics Mail
ALLOW_PUBLIC_REGISTRATION=true
MAX_ATTACHMENT_MB=8
COOKIE_SECURE=true
